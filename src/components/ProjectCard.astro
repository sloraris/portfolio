---
import type { CollectionEntry } from 'astro:content';
import { projectHref } from '../lib/site';

interface Props {
  project: CollectionEntry<'posts'>;
}

const { data } = Astro.props.project;
const status = data.status ?? 'active';
const stack = data.stack ?? [];
const archived = status === 'archived';
---

{/*
  The whole card is clickable through a stretched title link (the ::after covers the card),
  so the repo / demo links can sit inside it without nesting <a> in <a>. They are raised above
  the stretched link with `relative z-10`.
*/}
<article
  class:list={[
    'post-card relative flex flex-col h-full w-full rounded-lg bg-base-100',
    'has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-glow',
    archived && 'opacity-70',
  ]}
>
  {data.cover && <img src={data.cover} alt="" loading="lazy" class="w-full rounded-t-lg aspect-video object-cover" />}

  <div class="flex flex-col grow gap-1 p-4">
    <div class="flex items-start justify-between gap-2">
      <h2 class="text-xl font-bold">
        <a href={projectHref(data.slug)} class="after:absolute after:inset-0 focus-visible:outline-none">{data.title}</a>
      </h2>
      <div class="flex gap-1 shrink-0 mt-1">
        {data.draft && <span class="badge badge-warning badge-sm">Draft</span>}
        {status !== 'active' && <span class="badge badge-outline badge-sm capitalize">{status}</span>}
      </div>
    </div>

    {data.description && <p class="py-1 grow">{data.description}</p>}

    {stack.length > 0 && (
      <div class="flex flex-wrap gap-2 pt-1">
        {stack.map((tech) => <span class="badge badge-outline">{tech}</span>)}
      </div>
    )}

    {(data.repo || data.demo) && (
      <div class="relative z-10 flex flex-wrap gap-x-4 gap-y-1 pt-3 text-sm">
        {data.repo && <a href={data.repo} target="_blank" rel="noopener" class="link link-hover">Repo ↗</a>}
        {data.demo && <a href={data.demo} target="_blank" rel="noopener" class="link link-hover">Demo ↗</a>}
      </div>
    )}
  </div>
</article>
